# ------------------------------------------------------------
# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env NO se sube a Git.
# ------------------------------------------------------------

# Servidor
NODE_ENV=development
PORT=3001

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kiosco_db

# Autenticación
# Generá un valor largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión en horas
SESSION_HOURS=12

# Facturación electrónica (ARCA)
# Carpeta (dentro de backend/) donde se guardan la clave privada y los certificados.
# El resto se configura desde la pantalla Configuración → Facturación electrónica.
ARCA_CERTS_DIR=certs
