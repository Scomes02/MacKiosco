{
  "name": "kiosco-backend",
  "version": "1.0.0",
  "description": "API REST del sistema de gestión para kiosco (Express + MySQL)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:reset": "node scripts/db-setup.js --reset",
    "db:reset:vacio": "node scripts/db-setup.js --reset --sin-historial",
    "db:migrar": "node scripts/db-migrar.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^4.5.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "node-forge": "^1.4.0",
    "zod": "^3.25.0"
  }
}
